# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values. Do NOT commit .env.
# ─────────────────────────────────────────────────────────────

# METABASE (optional default server URL; each user signs in with their own account)
METABASE_URL=https://metabase.cloudfuze.com

# AI (natural language) mode — provide ONE key. Priority: Gemini → OpenAI → Anthropic.
# Google Gemini (free tier): https://aistudio.google.com/apikey  (starts with AIza…)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenAI (optional) — starts with sk-proj-/sk-
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Semantic doc search (RAG) — embedding model per provider. Defaults shown; these
# reuse the SAME key above. Leave blank to use the default. If embeddings are
# unavailable, documentation search automatically falls back to keyword matching.
GEMINI_EMBED_MODEL=gemini-embedding-001
OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic (optional) — starts with sk-ant-
ANTHROPIC_API_KEY=

# Server settings
SESSION_SECRET=change-me-to-a-random-secret
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
